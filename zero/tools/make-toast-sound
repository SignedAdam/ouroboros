#!/opt/homebrew/bin/python3.11
"""Synthesises the toast sound Ouroboros plays when a run lands.

The brief was Jared Leto's ringtone in Blade Runner 2049 (he plays Wallace): a
chirpy pulse, twice, inside about a second. So it is two short chirps, not a
chime and not a drone. Each chirp sweeps in pitch over a few tens of
milliseconds, which is what makes it read as a chirp rather than a beep, over an
optional low partial that gives it body on a laptop speaker.

Every character decision is a flag, because the difference between a good one
and a bad one is entirely taste and the only way to choose is to hear them side
by side. See `audition-toast-sound` for that.

    make-toast-sound out.wav                       # the current chosen sound
    make-toast-sound out.wav --gap 0.18 --sweep 0.6 --base 1200

Rendered rather than recorded so it lives in the repo as a file you can retune,
instead of a binary nobody can adjust.
"""
import argparse
import math
import struct
import wave

RATE = 48_000

DEFAULTS = dict(
    base=880.0,      # Hz of the first chirp
    interval=1.122,  # second chirp relative to the first (a whole tone up)
    gap=0.230,       # seconds between the two chirp onsets
    sweep=1.5,       # end/start pitch ratio. >1 rises, <1 falls, 1.0 is flat
    glide=0.130,     # seconds the sweep takes
    decay=26.0,      # tail rate — higher is snappier
    body=0.30,       # gain of the low partial under each chirp, 0 for none
    shimmer=0.22,    # second-harmonic gain — brightness
    second=0.78,     # gain of the second chirp relative to the first
)

def chirp(t, base, gain, p):
    """One pitch sweep with a fast attack and an exponential tail."""
    if t < 0 or t > 1.0:
        return 0.0
    k = (base * (p.sweep - 1.0)) / p.glide
    swept = min(t, p.glide)
    phase = 2 * math.pi * (base * t + 0.5 * k * swept ** 2)
    tone = (math.sin(phase)
            + p.shimmer * math.sin(2 * phase)
            + p.shimmer * 0.3 * math.sin(3 * phase))
    attack = min(1.0, t / 0.006)          # fast, but never a click
    return tone * attack * math.exp(-t * p.decay) * gain

def render(p):
    voices = [(0.0, p.base, 1.0), (p.gap, p.base * p.interval, p.second)]
    dur = p.gap + 0.55
    out = []
    for i in range(int(RATE * dur)):
        t = i / RATE
        sample = sum(chirp(t - start, base, gain, p) for start, base, gain in voices)
        if p.body:
            for start, _, gain in voices:
                dt = t - start
                if 0 <= dt < 0.5:
                    sample += (p.body * gain
                               * math.sin(2 * math.pi * 146.8 * dt)
                               * math.exp(-dt * 9.0))
        out.append(math.tanh(sample * 0.9) * 0.8)

    peak = max(abs(s) for s in out) or 1.0
    return [s / peak * 0.78 for s in out]

def write(path, samples):
    with wave.open(path, "w") as f:
        f.setnchannels(1)
        f.setsampwidth(2)
        f.setframerate(RATE)
        f.writeframes(b"".join(
            struct.pack("<h", int(max(-1.0, min(1.0, s)) * 32767)) for s in samples))

def parser():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("output", nargs="?", default="toast.wav")
    for name, value in DEFAULTS.items():
        ap.add_argument(f"--{name}", type=float, default=value)
    return ap

if __name__ == "__main__":
    args = parser().parse_args()
    write(args.output, render(args))
    print(args.output)
